rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function room(r) { return /databases/$(database)/documents/rooms/$(r); }
    function isMember(r) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(r)/members/$(request.auth.uid)); }
    function willBeMember(r) { return signedIn() && existsAfter(/databases/$(database)/documents/rooms/$(r)/members/$(request.auth.uid)); }
    function isOwner(r) { return signedIn() && get(room(r)).data.createdBy == request.auth.uid; }

    match /rooms/{r} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if isMember(r);
      allow update, delete: if isOwner(r);

      match /members/{u} {
        allow read: if isMember(r) || (signedIn() && request.auth.uid == u);
        allow create: if signedIn() && request.auth.uid == u && request.resource.data.xp == 0 && (
          getAfter(room(r)).data.createdBy == u ||
          get(/databases/$(database)/documents/rooms/$(r)/invites/$(request.resource.data.token)).data.active == true);
        allow update: if isOwner(r) || (signedIn() && request.auth.uid == u &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar']));
        allow delete: if isOwner(r);
      }
      match /invites/{t} {
        allow get: if signedIn();
        allow create: if willBeMember(r);
        allow update, delete: if isOwner(r);
      }
      match /secrets/{t} {
        allow read, write: if isOwner(r);
      }
      match /proofs/{t} {
        allow read: if isOwner(r) || (isMember(r) && resource.data.by == request.auth.uid);
        allow create: if isMember(r) && request.resource.data.by == request.auth.uid
          && request.resource.data.photo is string && request.resource.data.photo.size() < 900000
          && get(/databases/$(database)/documents/rooms/$(r)/tasks/$(t)).data.assignee == request.auth.uid;
        allow update: if isMember(r) && resource.data.by == request.auth.uid && request.resource.data.by == request.auth.uid
          && request.resource.data.photo is string && request.resource.data.photo.size() < 900000;
        allow delete: if isOwner(r);
      }
      match /tasks/{t} {
        allow read: if isMember(r);
        allow create: if isOwner(r) && request.resource.data.status == 'todo'
          && request.resource.data.type in ['text','quiz','puzzle','candy']
          && (!('desc' in request.resource.data) || request.resource.data.desc.size() <= 3000);
        allow delete: if isOwner(r);
        allow update: if isOwner(r) || (isMember(r) && resource.data.assignee == request.auth.uid
          && resource.data.status in ['todo','rejected']
          && request.resource.data.status == 'submitted'
          && request.resource.data.proof.size() >= 3 && request.resource.data.proof.size() <= 3000
          && (resource.data.get('deadline', 0) == 0 || request.time.toMillis() <= resource.data.deadline)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','proof','choice','choices']));
      }
    }
    match /users/{u} { allow read, write: if signedIn() && request.auth.uid == u; }
    match /users/{u}/rooms/{r} { allow read, write: if signedIn() && request.auth.uid == u; }
    match /users/{u}/templates/{t} { allow read, write: if signedIn() && request.auth.uid == u; }
  }
}
