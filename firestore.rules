rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(r) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(r)/members/$(request.auth.uid)); }
    function willBeMember(r) { return signedIn() && existsAfter(/databases/$(database)/documents/rooms/$(r)/members/$(request.auth.uid)); }

    match /rooms/{r} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update: if isMember(r);

      match /members/{u} {
        allow read: if isMember(r) || (signedIn() && request.auth.uid == u);
        allow create: if signedIn() && request.auth.uid == u && (
          getAfter(/databases/$(database)/documents/rooms/$(r)).data.createdBy == u ||
          get(/databases/$(database)/documents/rooms/$(r)/invites/$(request.resource.data.token)).data.active == true);
      }
      match /invites/{t} {
        allow get: if signedIn();
        allow create, update, delete: if willBeMember(r);
      }
      match /log/{l} {
        allow read, create: if isMember(r);
      }
    }
    match /users/{u}/rooms/{r} {
      allow read, write: if signedIn() && request.auth.uid == u;
    }
  }
}
